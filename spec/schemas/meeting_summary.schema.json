{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_summary.schema.json",
  "title": "Meeting summary",
  "description": "Evidence-grounded meeting notes (prompt version 2). Every item cites at least one transcript segment id and may carry an exact supporting quote. Topics are a narrative paragraph plus optional distinct key points. Sections with nothing to report are empty arrays (the UI omits them). The fields check, note and deadline_tentative are added by the app after validation, never by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overview",
    "executive_summary",
    "topics",
    "decisions",
    "action_items",
    "risks",
    "open_questions",
    "numbers",
    "next_steps",
    "takeaway"
  ],
  "properties": {
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "duration_min", "participants", "purpose"],
      "properties": {
        "title": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "duration_min": { "type": ["number", "null"], "minimum": 0 },
        "participants": { "type": "array", "items": { "type": "string" } },
        "purpose": { "type": ["string", "null"] }
      }
    },
    "executive_summary": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "narrative", "key_points"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "narrative": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/point" }],
            "description": "One connected paragraph about the topic (reasons, conditions and caveats kept)."
          },
          "key_points": {
            "type": "array",
            "items": { "$ref": "#/$defs/point" },
            "description": "Only distinct takeaways, usually 0-3. Never one item per sentence. (Version 1 called this 'points'; the app still reads that name.)"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "status", "evidence"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirmed", "proposed"], "description": "confirmed only with words of agreement in the cited segments; the app downgrades otherwise." },
          "evidence": { "$ref": "#/$defs/evidence" },
          "quote": { "$ref": "#/$defs/quote" }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner", "deadline", "evidence"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "owner": { "type": ["string", "null"], "description": "null is shown as 'Not specified'." },
          "deadline": { "type": ["string", "null"], "description": "null is shown as 'Not specified'. Hedges such as 'maybe' are kept." },
          "evidence": { "$ref": "#/$defs/evidence" },
          "quote": { "$ref": "#/$defs/quote" }
        }
      }
    },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "context", "evidence"],
        "properties": {
          "value": { "type": "string", "minLength": 1, "description": "Exactly as spoken." },
          "context": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "next_steps": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "takeaway": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/point" }]
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Transcript segment ids that directly support the item."
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "quote": { "$ref": "#/$defs/quote" }
      }
    },
    "quote": {
      "type": ["string", "null"],
      "description": "Exact words copied from a cited segment that support the item. The app checks that they occur there."
    }
  }
}
