# Build output
/target/
node_modules/
dist/
*.tsbuildinfo

# Speech models and audio never go into git
/models/
*.gguf
*.ggml
*.onnx
*.bin

# The owner's own voice recordings stay on this laptop
/bench/my_recordings/*
!/bench/my_recordings/README.md
/bench/audio_cache/

# Secrets (keys live in the OS keystore, never in files)
.env
.env.*
*.keystore
*.jks
*.pfx

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Tauri generated files
apps/desktop/src-tauri/gen/
/apps/desktop/app-icon.png
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/

# Generated WebAssembly bindings (built by scripts/build-wasm.mjs)
apps/web/src/wasm/
apps/web/dist/

# Android build output (APK built in GitHub Actions)
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/app/src/main/jniLibs/
apps/android/local.properties

